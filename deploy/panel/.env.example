# Remnawave panel. Variable names follow remnawave/backend .env.sample (3.x); check against the pinned version.
# Pinned (ТЗ 11). Tests/Mendeleev.ContractTests read this line: bump it in a branch, let CI run the
# contract tests against the new tag, and only then update the panel (runbook docs/runbooks/panel-update.md).
REMNAWAVE_TAG=3.4.4
PANEL_DOMAIN=panel.example-tech.com
# Port of the API behind Caddy. Staging, where the panel shares the VPS with the node whose Xray holds 443:
#   PANEL_PORT=9443
#   COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml
# (docs/staging.md). The service then calls https://<PANEL_DOMAIN>:9443.
PANEL_PORT=443
# Required: who may call the API — the management VPS IP (several: space-separated). Nobody else, admins
# included: the UI is reached through an SSH tunnel (ТЗ 31).
PANEL_ALLOWED_IPS=

APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1

POSTGRES_USER=remnawave
POSTGRES_PASSWORD=
POSTGRES_DB=remnawave
DATABASE_URL=postgresql://remnawave:CHANGE_ME@remnawave-db:5432/remnawave
REDIS_SOCKET=/var/run/valkey/valkey.sock

# openssl rand -hex 64
APP_SECRET=

FRONT_END_DOMAIN=panel.example-tech.com
# Public subscription domain served by Subscription Page on the management VPS
SUB_PUBLIC_DOMAIN=sub.example-subs.com

METRICS_USER=
METRICS_PASS=

# Webhooks to the service's technical domain (FR-PNL-13). The secret = Remnawave__WebhookSecret of the service.
WEBHOOK_ENABLED=true
WEBHOOK_URL=https://hooks.example-tech.com/webhooks/remnawave
# At least 32 characters, letters and digits only (the panel refuses to start otherwise): openssl rand -hex 32
WEBHOOK_SECRET_HEADER=

# The panel's own notifications are off: alerts go through the service and Uptime Kuma.
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
SHORT_UUID_METHOD=nanoid
SHORT_UUID_LENGTH=16

# ── Backups: encrypted dumps of the panel DB to the Russian S3, prefix panel/ (ТЗ 40) ─────────────
# The same age public key as the service's backups; the private key is only with the owner and the tech admin.
BACKUP_AGE_RECIPIENT=
S3_ENDPOINT=https://s3.storage.selcloud.ru
S3_BUCKET=mendeleev-backups
S3_REGION=ru-1
# A separate key for this VPS, if the provider allows limiting it to panel/: a stolen panel VPS must not be
# able to delete the service's dumps.
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
# Cron in UTC (the container's zone); half an hour after the service's dump.
BACKUP_CRON=45 3 * * *
# Its own Uptime Kuma push monitor: no push for a day = alert
BACKUP_KUMA_PUSH_URL=
