# Remnawave panel. Variable names follow remnawave/backend .env.sample (3.x); check against the pinned version.
REMNAWAVE_TAG=latest
PANEL_DOMAIN=panel.example-tech.com

APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1

POSTGRES_USER=remnawave
POSTGRES_PASSWORD=
POSTGRES_DB=remnawave
DATABASE_URL=postgresql://remnawave:CHANGE_ME@remnawave-db:5432/remnawave
REDIS_SOCKET=/var/run/valkey/valkey.sock

# openssl rand -hex 64
APP_SECRET=

FRONT_END_DOMAIN=panel.example-tech.com
# Public subscription domain served by Subscription Page on the management VPS
SUB_PUBLIC_DOMAIN=sub.example-subs.com

METRICS_USER=
METRICS_PASS=

# Webhooks to the service's technical domain (FR-PNL-13). The secret = Remnawave__WebhookSecret of the service.
WEBHOOK_ENABLED=true
WEBHOOK_URL=https://hooks.example-tech.com/webhooks/remnawave
WEBHOOK_SECRET_HEADER=

# The panel's own notifications are off: alerts go through the service and Uptime Kuma.
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
SHORT_UUID_METHOD=nanoid
SHORT_UUID_LENGTH=16
