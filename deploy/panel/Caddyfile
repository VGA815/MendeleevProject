{
	# Caddy's own log (docker logs) gets every request that failed in a handler, a 502 while the panel restarts
	# for one, with its path (a subscription request carries the user's shortUuid), client IP and headers.
	# Only the error stays (ТЗ 31), as on the management VPS.
	log default {
		format filter {
			wrap json
			fields {
				request>uri replace /***
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
			}
		}
	}
}

# TLS for the panel API. PANEL_PORT is 443 on the panel VPS; on staging the panel shares the VPS with the node,
# whose Xray holds 443, so the API moves to another port (docker-compose.staging.yml).
{$PANEL_DOMAIN}:{$PANEL_PORT:443} {
	# The API is only for the management VPS (ТЗ 31, «Доступ к админкам»); admins reach the UI through an SSH
	# tunnel to 127.0.0.1:3000. This is the guard itself: Docker publishes the port past ufw. An empty list
	# shuts everyone out rather than letting everyone in; compose refuses to start without one.
	@outsiders not remote_ip {$PANEL_ALLOWED_IPS}
	abort @outsiders
	reverse_proxy remnawave:3000
}

# The UI through an SSH tunnel: ssh -L 3000:127.0.0.1:3000 <panel VPS>, then http://localhost:3000; compose
# publishes this port on the VPS loopback only. Remnawave resets every connection that did not come through an
# HTTPS reverse proxy, a direct tunnel to the panel's own port included; here the tunnel is the encryption.
http://:3000 {
	reverse_proxy remnawave:3000 {
		header_up X-Forwarded-Proto https
	}
}
