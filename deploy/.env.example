# Template. The real .env lives only on the server: chmod 600, owned by the service user (ТЗ 31, «Секреты»).
# A copy of every secret goes to the owner's encrypted archive.

# ── Images ───────────────────────────────────────────────────────────────────────────────────────
# ghcr.io/<GitHub owner in lowercase>, as CI publishes; the server logs in with a read:packages token.
REGISTRY=ghcr.io/your-org
APP_TAG=latest
# Pinned Remnawave versions (ТЗ 11): update only after the adapter's contract tests pass.
# Subscription Page 8.x is the line released with the panel 3.x (8.0.0 = 01.08.2026).
SUBSCRIPTION_PAGE_TAG=8.0.0

# ── Domains (not in .ru/.рф; Cloudflare DNS only, TTL 300) ─────────────────────────────────────
SITE_DOMAIN=example-site.com
SITE_DOMAIN_RESERVE=example-site-reserve.com
SUB_DOMAIN=sub.example-subs.com
SUB_DOMAIN_RESERVE=sub.example-subs-reserve.com
# Technical, unpublished domain for webhooks
WEBHOOK_DOMAIN=hooks.example-tech.com
ACME_EMAIL=admin@example.com

# ── Service ──────────────────────────────────────────────────────────────────────────────────────
Service__Name=Mendeleev
Service__SiteBaseUrl=https://example-site.com
Service__WebhookBaseUrl=https://hooks.example-tech.com
Service__BotUsername=your_bot

Site__OperatorName=
Site__OperatorDetails=
Site__SupportEmail=

# base64 of 32+ random bytes: openssl rand -base64 48. NEVER rotate without reissuing all keys.
Accounts__KeyPepper=

# ── PostgreSQL ───────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=mendeleev
POSTGRES_USER=mendeleev_owner
POSTGRES_PASSWORD=
POSTGRES_APP_USER=mendeleev_app
POSTGRES_APP_PASSWORD=

# ── Telegram ─────────────────────────────────────────────────────────────────────────────────────
Telegram__BotToken=
# openssl rand -hex 32 (letters, digits, _ and - only)
Telegram__WebhookSecret=
# Webhook | Polling
Telegram__Mode=Webhook
# Proxy abroad for the Bot API, if the Russian DC cannot reach it. DPI drops api.telegram.org by SNI, so the hop
# abroad must be encrypted: the SSH tunnel of the profile telegram-tunnel, socks5://telegram-tunnel:1080
# (runbook docs/runbooks/bot-api-unreachable.md).
Telegram__ProxyUrl=
# user@host abroad for that tunnel
TELEGRAM_TUNNEL_TARGET=

# ── Remnawave (panel abroad; its API is open only to this VPS IP) ──────────────────────────────
Remnawave__BaseUrl=https://panel.example-tech.com
Remnawave__ApiToken=
# Same value as WEBHOOK_SECRET_HEADER in the panel .env
Remnawave__WebhookSecret=
# Remnawave__Squads__basic=
# Remnawave__Squads__premium=
REMNAWAVE_PANEL_URL=https://panel.example-tech.com
SUBSCRIPTION_PAGE_API_TOKEN=

# ── Payments ─────────────────────────────────────────────────────────────────────────────────────
# false until there is a contract: launch on trials + manual extensions (ТЗ 23)
Payments__Enabled=false
Payments__ActiveProvider=fake
Payments__Fake__Enabled=false
# Lava (developer.lava.ru): the project in the Lava cabinet → shopId, «Секретный ключ», «Дополнительный ключ».
# With Payments__Enabled=true set Payments__ActiveProvider=lava; the service does not start without the keys.
Payments__Lava__Enabled=false
Payments__Lava__ShopId=
Payments__Lava__SecretKey=
Payments__Lava__WebhookKey=
# Methods on Lava's page; none listed — whatever the project has on: card, sbp, sber_pay, mir_pay, mir_card
# Payments__Lava__IncludeServices__0=card
# Payments__Lava__IncludeServices__1=sbp

# ── Staff bootstrap: the first admin and tech admin (ТЗ 28) ─────────────────────────────────────
# Numeric values (Telegram IDs, chat IDs, squad UUIDs) must be filled in or stay commented out:
# an empty value fails configuration binding at startup.
# Seed__Staff__0__TelegramId=
# Seed__Staff__0__Role=TechAdmin
# Seed__Staff__0__DisplayName=Техадмин
# Seed__Staff__1__TelegramId=
# Seed__Staff__1__Role=Admin
# Seed__Staff__1__DisplayName=Владелец

# Prices: set in the DB after the first start (ТЗ 28). Seed only creates missing tariffs, inactive with price 0.

# ── Alerts: alert bot + second channel (ТЗ 30) ──────────────────────────────────────────────────
Alerts__TelegramBotToken=
# Alerts__TechAdminChatIds__0=
# Alerts__AdminChatIds__0=
Alerts__NtfyTopicUrl=
Alerts__NtfyToken=

# ── Backups: encrypted dumps to Russian S3 at another provider (ТЗ 40) ────────────────────────
# age public key; the private key is only with the owner and the tech admin
BACKUP_AGE_RECIPIENT=
S3_ENDPOINT=https://s3.storage.selcloud.ru
S3_BUCKET=mendeleev-backups
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=15 3 * * *
# Uptime Kuma push monitor: no push for a day = alert
BACKUP_KUMA_PUSH_URL=
