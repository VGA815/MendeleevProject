# TLS and reverse proxy on the management VPS (ТЗ 40, «Домены и TLS»). DNS: Cloudflare, DNS only.
# Reserve domains are served from day one, so switching is a DNS change (runbook «Заблокирован домен»).

{
	# Caddy is the edge: it does not trust X-Forwarded-For from clients; the app trusts Caddy's.
	email {$ACME_EMAIL}

	# Caddy's own log (docker logs) gets every request that failed in a handler, a 502 while app or
	# subscription-page restarts for one, with its path (a user's secret on the subscription domains), client IP
	# and headers. Docker keeps it by size, not for 7 days (ТЗ 31): only the error stays.
	log default {
		format filter {
			wrap json
			fields {
				request>uri replace /***
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
			}
		}
	}
}

(common) {
	encode zstd gzip
	header -Server
	# /metrics is internal only (ТЗ 30): never proxied.
	@metrics path /metrics /metrics/*
	respond @metrics 404
}

# Access log: IP and time of the request, kept 7 days (ТЗ 31, «Логи и приватность»). Headers are dropped:
# they carry the cabinet session cookie, webhook secrets and signatures.
(private_log) {
	format filter {
		wrap json
		fields {
			request>remote_port delete
			request>headers delete
			request>tls delete
			resp_headers delete
		}
	}
}

# Site and cabinet. Webhooks are not accepted here on purpose.
{$SITE_DOMAIN}, {$SITE_DOMAIN_RESERVE} {
	import common
	header Strict-Transport-Security "max-age=31536000"
	@webhooks path /webhooks/*
	respond @webhooks 404
	reverse_proxy app:8080
	log {
		output file /data/logs/site.log {
			roll_size 20MiB
			roll_keep_for 168h
		}
		import private_log
	}
}

# Unpublished technical domain: Telegram, the aggregator and the panel keep delivering
# even if the site domain is blocked (решение 24.09).
{$WEBHOOK_DOMAIN} {
	import common
	@allowed path /webhooks/* /health/ready /health/live
	handle @allowed {
		request_body {
			max_size 256KB
		}
		reverse_proxy app:8080
	}
	respond 404
	log {
		output file /data/logs/webhooks.log {
			roll_size 20MiB
			roll_keep_for 168h
		}
		import private_log
	}
}

# Subscription links. The path is the user's secret: it is masked in the logs, the IP stays (ТЗ 31).
{$SUB_DOMAIN}, {$SUB_DOMAIN_RESERVE} {
	import common
	header Referrer-Policy no-referrer
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy subscription-page:3010
	log {
		output file /data/logs/subscriptions.log {
			roll_size 20MiB
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>uri replace /***
				request>remote_port delete
				request>headers delete
				request>tls delete
				resp_headers delete
			}
		}
	}
}
