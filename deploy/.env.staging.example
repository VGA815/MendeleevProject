# Staging VPS (ТЗ 40, «Окружения»; docs/staging.md). Same compose as production plus docker-compose.staging.yml;
# this file differs from .env.example only where staging must differ. Production tokens, bot, panel and bucket
# are never used here. The real .env lives only on the server: chmod 600.

COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml
# backup — only with the staging bucket below filled in
COMPOSE_PROFILES=
# Payments and tariff prices for staging are in appsettings.Staging.json: the fake aggregator, test prices.
ASPNETCORE_ENVIRONMENT=Staging

# ── Images ───────────────────────────────────────────────────────────────────────────────────────
# ghcr.io/<GitHub owner in lowercase>; the load test image is published next to the service's.
REGISTRY=ghcr.io/your-org
APP_TAG=latest
SUBSCRIPTION_PAGE_TAG=8.0.0

# ── Domains: one staging domain, never subdomains of the production ones ─────────────────────────
SITE_DOMAIN=example-stg.com
SITE_DOMAIN_RESERVE=site2.example-stg.com
SUB_DOMAIN=sub.example-stg.com
SUB_DOMAIN_RESERVE=sub2.example-stg.com
WEBHOOK_DOMAIN=hooks.example-stg.com
ACME_EMAIL=admin@example.com

# ── Service ──────────────────────────────────────────────────────────────────────────────────────
Service__Name=Mendeleev (staging)
Service__SiteBaseUrl=https://example-stg.com
Service__WebhookBaseUrl=https://hooks.example-stg.com
Service__BotUsername=your_staging_bot

Site__OperatorName=
Site__OperatorDetails=
Site__SupportEmail=

# Its own: openssl rand -base64 48
Accounts__KeyPepper=

# ── PostgreSQL ───────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=mendeleev
POSTGRES_USER=mendeleev_owner
POSTGRES_PASSWORD=
POSTGRES_APP_USER=mendeleev_app
POSTGRES_APP_PASSWORD=

# ── Telegram: the staging bot ────────────────────────────────────────────────────────────────────
Telegram__BotToken=
Telegram__WebhookSecret=
Telegram__Mode=Webhook
# Leave empty first: whether the Bot API is reachable from this DC without a proxy is one of the checks.
# Not reachable: the SSH tunnel to the node VPS, socks5://telegram-tunnel:1080 (docs/staging.md, step 8).
Telegram__ProxyUrl=
TELEGRAM_TUNNEL_TARGET=

# ── Remnawave: the staging panel on the node's VPS, API on port 9443 ─────────────────────────────
Remnawave__BaseUrl=https://panel.example-stg.com:9443
Remnawave__ApiToken=
Remnawave__WebhookSecret=
# UUIDs of the staging panel's squads
# Remnawave__Squads__basic=
# Remnawave__Squads__premium=
REMNAWAVE_PANEL_URL=https://panel.example-stg.com:9443
SUBSCRIPTION_PAGE_API_TOKEN=

# ── Payments: the fake aggregator (appsettings.Staging.json) ─────────────────────────────────────
# Signs the webhooks of /dev/fake-pay; the service does not start without it: openssl rand -hex 32
Payments__Fake__WebhookSecret=

# Lava with real payments, next to the fake one (docs/staging.md, «Lava»). New payments go to the
# provider in Payments__ActiveProvider: fake or lava. The keys are typed in by a human.
# Payments__Lava__Enabled=true
# Payments__Lava__ShopId=
# Payments__Lava__SecretKey=
# Payments__Lava__WebhookKey=
# Payments__ActiveProvider=lava

# ── Staff: the testers (ТЗ 28) ───────────────────────────────────────────────────────────────────
# Seed__Staff__0__TelegramId=
# Seed__Staff__0__Role=TechAdmin
# Seed__Staff__0__DisplayName=Техадмин

# ── Alerts: a staging chat and topic, so that staging never wakes anyone up at night ────────────
Alerts__TelegramBotToken=
# Alerts__TechAdminChatIds__0=
# Alerts__AdminChatIds__0=
Alerts__NtfyTopicUrl=
Alerts__NtfyToken=

# ── Backups: a separate bucket, key and age key pair — never the production ones ─────────────────
BACKUP_AGE_RECIPIENT=
S3_ENDPOINT=https://s3.storage.selcloud.ru
S3_BUCKET=mendeleev-staging
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=7
BACKUP_CRON=15 3 * * *
BACKUP_KUMA_PUSH_URL=
