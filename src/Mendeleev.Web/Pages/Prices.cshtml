@page "/prices"
@model PricesModel
@{
    ViewData["Title"] = "Цены";
}
<h1>Цены</h1>
@if (Model.Tariffs.Count == 0)
{
    <p>Продажи скоро откроются.</p>
}
else
{
    <ul class="tariffs">
        @foreach (var tariff in Model.Tariffs)
        {
            <partial name="_TariffCard" model="new TariffCard(tariff, CanPay: false)" />
        }
    </ul>
    <p class="muted">Оплата картой или через СБП на странице платёжного сервиса. Продление прибавляет срок к текущему. Автосписаний нет.</p>
}
