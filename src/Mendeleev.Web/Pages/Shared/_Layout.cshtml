@inject IOptions<ServiceOptions> Service
@{
    bool signedIn = User.Identity?.IsAuthenticated == true;
    string path = Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    string? Current(string section) =>
        path.Equals(section, StringComparison.OrdinalIgnoreCase) || path.StartsWith(section + "/", StringComparison.OrdinalIgnoreCase) ? "page" : null;
    // Pages with the brand grid behind the content: the home page and sign-in.
    string mainClass = ViewData["Grid"] is true ? "site-main grid-band" : "site-main";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <title>@ViewData["Title"] — @Service.Value.Name</title>
    @* Own styles, fonts and icons only: nothing from other sites, no analytics (FR-WEB-10). *@
    <meta name="theme-color" content="#2F5BFF" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/geologica-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a class="brand" href="/">
                <img src="/favicon.svg" width="32" height="32" alt="" />
                <span>@Service.Value.Name</span>
            </a>
            <nav class="site-nav" aria-label="Меню">
                <a href="/prices" aria-current="@Current("/prices")">Цены</a>
                @if (signedIn)
                {
                    <a href="/cabinet" aria-current="@Current("/cabinet")">Кабинет</a>
                    <form method="post" action="/logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="link-button">Выйти</button>
                    </form>
                }
                else
                {
                    <a href="/login" aria-current="@Current("/login")">Войти</a>
                }
            </nav>
        </div>
    </header>
    <main class="@mainClass">
        <div class="container">
            @RenderBody()
        </div>
    </main>
    <footer class="site-footer">
        <div class="container">
            <nav aria-label="Документы">
                <a href="/offer">Оферта</a>
                <a href="/privacy">Конфиденциальность</a>
                <a href="/contacts">Контакты</a>
            </nav>
            <span>© @DateTime.UtcNow.Year @Service.Value.Name</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
