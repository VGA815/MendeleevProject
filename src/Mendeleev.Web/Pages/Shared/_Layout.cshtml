@inject IOptions<ServiceOptions> Service
@{
    bool signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <title>@ViewData["Title"] — @Service.Value.Name</title>
    @* No external fonts, scripts or analytics (FR-WEB-10). *@
    <style>
        :root { color-scheme: light dark; --fg: #1b1f24; --muted: #5b6470; --bg: #ffffff; --panel: #f5f7fa; --accent: #2458d6; --line: #e3e7ee; --danger: #b42318; --ok: #1a7f37; }
        @@media (prefers-color-scheme: dark) { :root { --fg: #e8ebf0; --muted: #a2abb8; --bg: #12151a; --panel: #1b2027; --accent: #7fa4ff; --line: #2a303a; --danger: #ff8a80; --ok: #6fdd8b; } }
        * { box-sizing: border-box; }
        body { margin: 0; font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: var(--fg); background: var(--bg); }
        header, main, footer { max-width: 760px; margin: 0 auto; padding: 16px; }
        header { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: baseline; border-bottom: 1px solid var(--line); }
        header .brand { font-weight: 700; font-size: 18px; margin-right: auto; color: var(--fg); text-decoration: none; }
        a { color: var(--accent); }
        nav { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; }
        nav form { display: inline; margin: 0; }
        footer { color: var(--muted); font-size: 14px; border-top: 1px solid var(--line); margin-top: 32px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); }
        .button { display: inline-block; padding: 10px 16px; border-radius: 8px; background: var(--accent); color: #fff; text-decoration: none; border: 0; font: inherit; cursor: pointer; }
        .button.secondary { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
        .button.danger { background: var(--danger); }
        .link-button { background: none; border: 0; padding: 0; font: inherit; color: var(--accent); text-decoration: underline; cursor: pointer; }
        .muted { color: var(--muted); }
        .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin: 16px 0; }
        .notice { border-left: 4px solid var(--accent); padding: 8px 12px; background: var(--panel); margin: 16px 0; }
        .notice.error { border-color: var(--danger); }
        .notice.ok { border-color: var(--ok); }
        .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 12px 0; }
        .secret { font: 600 24px/1.3 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 1px; word-break: break-all; }
        .link { font: 14px/1.4 ui-monospace, SFMono-Regular, Consolas, monospace; word-break: break-all; }
        .qr { width: 220px; height: 220px; image-rendering: pixelated; background: #fff; padding: 8px; border-radius: 8px; }
        .content { white-space: pre-line; }
        .subnav { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 4px 0 16px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
        .subnav a[aria-current="page"] { color: var(--fg); font-weight: 600; text-decoration: none; }
        label { display: block; margin: 12px 0 6px; }
        input[type=text], input[type=password] { width: 100%; max-width: 360px; padding: 10px 12px; font: inherit; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--fg); }
        input.code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 1px; }
        .check { display: flex; gap: 8px; align-items: flex-start; }
        .check input { margin-top: 5px; }
    </style>
</head>
<body>
    <header>
        <a class="brand" href="/">@Service.Value.Name</a>
        <nav>
            <a href="/prices">Цены</a>
            <a href="/offer">Оферта</a>
            <a href="/privacy">Конфиденциальность</a>
            <a href="/contacts">Контакты</a>
            @if (signedIn)
            {
                <a href="/cabinet">Кабинет</a>
                <form method="post" action="/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="link-button">Выйти</button>
                </form>
            }
            else
            {
                <a href="/login">Войти</a>
            }
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        © @DateTime.UtcNow.Year @Service.Value.Name
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
