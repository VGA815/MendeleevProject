@inject IOptions<SiteOptions> Site
@inject IOptions<ServiceOptions> Service
@{
    SiteOptions site = Site.Value;
}
@* The seller and the contacts the aggregator's moderation looks for (lava.ru/site-requirements): on the contacts
   page, in the offer and in the personal data policy. *@
<dl class="requisites">
    <div>
        <dt>Исполнитель</dt>
        <dd>@site.OperatorName</dd>
    </div>
    @if (!string.IsNullOrWhiteSpace(site.OperatorDetails))
    {
        <div>
            <dt>Реквизиты</dt>
            <dd class="content">@site.OperatorDetails</dd>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(site.Address))
    {
        <div>
            <dt>Адрес</dt>
            <dd>@site.Address</dd>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(site.Phone))
    {
        <div>
            <dt>Телефон</dt>
            <dd><a href="tel:@site.PhoneLink">@site.Phone</a></dd>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(site.SupportEmail))
    {
        <div>
            <dt>Почта поддержки</dt>
            <dd><a href="mailto:@site.SupportEmail">@site.SupportEmail</a></dd>
        </div>
    }
    @if (!string.IsNullOrEmpty(Service.Value.BotUrl))
    {
        <div>
            <dt>Telegram-бот</dt>
            <dd><a href="@Service.Value.BotUrl" rel="noopener">@("@" + Service.Value.BotUsername)</a></dd>
        </div>
    }
</dl>
