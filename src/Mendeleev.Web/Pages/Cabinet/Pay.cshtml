@page "/cabinet/pay"
@model Mendeleev.Web.Pages.Cabinet.PayModel
@{
    ViewData["Title"] = "Оплата";
    var ru = System.Globalization.CultureInfo.GetCultureInfo("ru-RU");
}
@if (Model.Payment is { } payment)
{
    <h1>Оплата</h1>
    <div class="panel">
        <p class="pay-summary"><b>@payment.TariffName</b> — @payment.Amount.ToString("N0", ru) ₽ за @payment.Days дн.</p>
        @if (payment is { PromoCode: string promoCode, FullPrice: decimal full } && full > payment.Amount)
        {
            <p>Скидка по промокоду <b>@promoCode</b>: <s>@full.ToString("N0", ru) ₽</s> @payment.Amount.ToString("N0", ru) ₽.</p>
        }
        @if (payment.DroppedPromoCode is string dropped)
        {
            <div class="notice warn">Промокод <b>@dropped</b> больше не действует, поэтому цена — без скидки.</div>
        }
        <p>Оплата криптовалютой (USDT и другие) на странице платёжного сервиса, рубли пересчитываются по курсу на момент создания счёта. Комиссию сети и биржи добавьте сверх суммы счёта: если придёт меньше, счёт будет ждать доплаты. Срок прибавится к текущему.</p>
        @if (payment.Reused)
        {
            <div class="notice">У вас уже есть неоплаченный платёж на этот тариф — используйте его.</div>
        }
        <div class="actions">
            <a class="button" href="@payment.ConfirmationUrl" rel="noopener noreferrer">Перейти к оплате</a>
            <a href="/pay/return/@payment.PaymentId">Я оплатил — проверить</a>
        </div>
    </div>
    <p class="muted">После оплаты платёжный сервис вернёт вас на сайт, и мы покажем результат. Подписка продлится автоматически, как только перевод подтвердится в сети, — обычно за несколько минут.</p>
}
else
{
    <h1>Тарифы и оплата</h1>
    @if (Model.Error is string error)
    {
        <div class="notice error">@error</div>
    }
    @if (Model.Offer.Promo is { } promo)
    {
        <div class="notice ok">Промокод <b>@promo.Code</b>: скидка @promo.DiscountPercent %, цены ниже — уже со скидкой. Скидка действует на одну оплату.</div>
    }
    @if (Model.Offer.Tariffs.Count == 0)
    {
        <p>Продажи скоро откроются. Если нужна помощь — напишите в поддержку.</p>
    }
    else
    {
        <ul class="tariffs">
            @foreach (var offered in Model.Offer.Tariffs)
            {
                <partial name="_TariffCard" model="new TariffCard(offered.Tariff, CanPay: true, offered.FinalPrice)" />
            }
        </ul>
        <p class="muted">Оплата криптовалютой (USDT и другие) на странице платёжного сервиса. Продление прибавляет срок к текущему. Автосписаний нет. Оплачивая подписку, вы принимаете условия <a href="/offer">оферты</a>.</p>
    }
    <form method="post" asp-page="/Cabinet/Promo" class="panel promo-form">
        <label for="promo-code">Промокод</label>
        <div class="promo-row">
            <input id="promo-code" name="code" type="text" maxlength="32" autocomplete="off" autocapitalize="characters" spellcheck="false" required />
            <button type="submit" class="button secondary">Применить</button>
        </div>
    </form>
}
